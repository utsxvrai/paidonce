CREATE CONSTRAINT customer_id IF NOT EXISTS FOR (n:Customer) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT order_id IF NOT EXISTS FOR (n:Order) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT attempt_id IF NOT EXISTS FOR (n:Attempt) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT txn_id IF NOT EXISTS FOR (n:Txn) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT bank_id IF NOT EXISTS FOR (n:BankLine) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT webhook_id IF NOT EXISTS FOR (n:Webhook) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ledger_id IF NOT EXISTS FOR (n:LedgerEntry) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT refund_id IF NOT EXISTS FOR (n:Refund) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT reversal_id IF NOT EXISTS FOR (n:Reversal) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ticket_id IF NOT EXISTS FOR (n:Ticket) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT release_id IF NOT EXISTS FOR (n:Release) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT outage_id IF NOT EXISTS FOR (n:Outage) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT component_id IF NOT EXISTS FOR (n:Component) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT qr_id IF NOT EXISTS FOR (n:Qr) REQUIRE n.id IS UNIQUE;
CREATE FULLTEXT INDEX ticket_text IF NOT EXISTS FOR (n:Ticket) ON EACH [n.text];
CREATE VECTOR INDEX ticket_vec IF NOT EXISTS FOR (n:Ticket) ON n.vec OPTIONS {indexConfig: {`vector.dimensions`: 384, `vector.similarity_function`: 'cosine'}};
